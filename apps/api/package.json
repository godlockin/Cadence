{
  "name": "@cadence/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/node.js",
    "./worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:static": "pnpm --filter @cadence/web build && mkdir -p dist/static && cp -r ../../apps/web/dist/. dist/static/",
    "start": "node dist/node.js",
    "start:prod": "pnpm build:static && pnpm build && node dist/node.js",
    "dev": "tsx watch src/node.ts",
    "dev:cf": "wrangler dev --local",
    "dev:node": "tsx watch src/node.ts",
    "dev:cron": "tsx scripts/dev-cron.ts",
    "dev:queue": "tsx scripts/dev-queue.ts",
    "seed": "tsx scripts/seed.ts",
    "deploy": "wrangler deploy",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@cadence/auth": "workspace:*",
    "@cadence/db": "workspace:*",
    "@cadence/domain": "workspace:*",
    "@cadence/executor-pipeline": "workspace:*",
    "@cadence/queue": "workspace:*",
    "@cadence/scheduler": "workspace:*",
    "@cadence/sinker": "workspace:*",
    "@cadence/storage": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.2",
    "vitest": "^2.1.5",
    "wrangler": "^3.91.0"
  }
}
