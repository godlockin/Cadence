{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["src/**", "eslint.config.mjs", "tsconfig.json"],
      "outputs": []
    },
    "type-check": {
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "inputs": ["src/**", "vitest.config.ts"],
      "outputs": ["coverage/**"]
    }
  }
}
