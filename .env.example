# PulseDeck environment — copy to `.env` and fill real values.
# `.env` is git-ignored; never commit secrets.

# --- Node.js runtime (local / Docker) ---
NODE_ENV=production
PORT=3000
# HOST=0.0.0.0
# PULSEDECK_DB_PATH=./data/pulsedeck.db
# PULSEDECK_STATIC_DIR=apps/web/dist

# --- Auth / encryption ---
# JWT_SECRET:     HS256 signing key, >= 16 chars.  Generate: `openssl rand -base64 32`
# ENCRYPTION_KEY: base64 of 32 raw bytes (AES-256-GCM master key).  Generate: `openssl rand -base64 32`
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-too

# --- Scheduler (start the cron loop inside the Node API process) ---
PULSEDECK_SCHEDULER_ENABLED=1

# --- Web dev proxy target (consumed by apps/web/vite.config.ts) ---
# API_PROXY=http://localhost:3000
