# PulseDeck Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# --- core ---
NODE_ENV=development
PULSEDECK_PORT=3000

# --- auth ---
# 32 bytes, base64-encoded. Generate: `openssl rand -base64 32`
PULSEDECK_JWT_SECRET=
PULSEDECK_PASSWORD_PEPPER=

# --- storage ---
# D1 binding (Workers) — set in wrangler.toml, not here
# SQLite path (Node runtime)
PULSEDECK_SQLITE_PATH=./data/pulsedeck.db

# --- logging ---
LOG_LEVEL=info
